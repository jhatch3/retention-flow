# RetentionFlow database configuration.
# Copy to `.env` and fill in real values. `.env` is gitignored.

# PostgreSQL connection string. For local Docker Postgres use the default
# below; for Supabase, paste the connection string from the project settings
# (a bare postgresql:// URL is fine -- the psycopg2 driver is added for you).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/retention_flow

# Echo emitted SQL to stdout (useful when debugging).
DB_ECHO=false

# SQLAlchemy connection pool tuning.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
